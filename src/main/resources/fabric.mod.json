{
  "schemaVersion": 1,
  "id": "fixpots-armor-hud",
  "version": "${version}",
  "name": "fixpot's Armor HUD",
  "description": "A minimalistic vanilla-like armor HUD with durability warnings. Based on uku's Armor HUD, maintained by fixpot47.",
  "authors": ["fixpot47"],
  "contributors": ["BerdinskiyBear (original author)", "uku (upstream fork)", "AnAwesomGuy"],
  "contact": {
    "homepage": "https://github.com/fixpot47/fixpot-s-armor-hud",
    "sources": "https://github.com/fixpot47/fixpot-s-armor-hud",
    "issues": "https://github.com/fixpot47/fixpot-s-armor-hud/issues"
  },
  "license": "MIT",
  "icon": "assets/fixpots-armor-hud/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["ru.berdinskiybear.armorhud.fabric.ArmorHudFabric"],
    "ukulib": ["ru.berdinskiybear.armorhud.config.UkulibIntegration"]
  },
  "mixins": ["fixpots-armor-hud.mixins.json"],
  "depends": {
    "minecraft": ">=26.2",
    "fabricloader": ">=0.19",
    "fabric-api": "*",
    "fixlib": ">=2.1.1"
  }
}
